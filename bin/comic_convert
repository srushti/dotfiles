#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'shellwords'
require 'tmpdir'
require 'fileutils'
require 'cgi'

# Prefer unar for .cbr extraction: 7z cannot decode newer RAR5 methods
UNAR = ENV["PATH"].split(File::PATH_SEPARATOR).map { |p| File.join(p, "unar") }.find { |p| File.executable?(p) }

options = { manga: false }
OptionParser.new do |opts|
  opts.banner = "Usage: comic_convert [options] <cbr_or_cbz_file>"
  opts.on("-m", "--manga", "Enable manga mode") { options[:manga] = true }
end.parse!

file = ARGV[0]
abort "Usage: comic_convert [options] <cbr_or_cbz_file>" unless file
abort "Error: File not found: #{file}" unless File.exist?(file)

# KCC deletes all KCC-* temp dirs on startup, so concurrent conversions break
# each other. Serialize via a lockfile.
KCC_LOCK = File.open(File.join(Dir.tmpdir, "kcc_convert.lock"), File::RDWR | File::CREAT)
unless KCC_LOCK.flock(File::LOCK_EX | File::LOCK_NB)
  puts "Another conversion is running; waiting for it to finish..."
  KCC_LOCK.flock(File::LOCK_EX)
end

ext = File.extname(file).downcase
abort "Error: Unsupported file extension #{ext}. Only .cbz and .cbr are supported." unless %w[.cbz .cbr].include?(ext)

basename = File.basename(file, ext)
dir = File.dirname(File.expand_path(file))

# Title = everything up to the (YYYY) publication year.
# Trailing metadata tags like " (Digital) (Shan-Empire)" are dropped.
# e.g. "Batwoman 007 (2026) (digital) (Pyrate-DCP)" -> "Batwoman 007"
# e.g. "Teenage Mutant Ninja Turtles (2024) 022 (2026) (digital) (...)"
#      -> "Teenage Mutant Ninja Turtles (2024) 022"
match = basename.match(/^(.*?)\s+\(\d{4}\)(?:\s+\([^)]+\))*$/)
title = match ? match[1].strip : basename

# Series/Number: trailing digits of the title are the issue number
num_match = title.match(/^(.*?)\s+(\d+)$/)
series = num_match ? num_match[1].strip : title
number = num_match ? num_match[2] : ""

# Escape values for XML
series_escaped = CGI.escapeHTML(series)
number_escaped = CGI.escapeHTML(number)
title_escaped = CGI.escapeHTML(title)

comic_info_xml = <<~XML
  <?xml version="1.0" encoding="utf-8"?>
  <ComicInfo>
    <Series>%s</Series>
    <Number>%s</Number>
    <Title>%s</Title>
  </ComicInfo>
XML

xml_content = format(comic_info_xml, series_escaped, number_escaped, title_escaped)
xml_file = File.join(Dir.pwd, "ComicInfo.xml")
File.write(xml_file, xml_content)

# Build kcc-c2e arguments
# kcc-c2e -o expects a directory, not a file path
FileUtils.mkdir_p(dir)
kcc_opts = [
  "-f", "EPUB",
  "-r", "2",
  "-u",
  "-c", "0",
  "--forcecolor",
  "-t", title,
  "-o", dir
]
kcc_opts << "-m" if options[:manga]

def convert(source, file, basename, dir, kcc_opts)
  puts "Converting #{file} to EPUB..."
  success = system("kcc-c2e", *kcc_opts, source)
  return unless success

  target = File.join(dir, "#{basename}.epub")
  # kcc-c2e may append a device suffix (e.g., .kepub.epub); find and rename
  candidates = Dir.glob(File.join(dir, "#{basename}*.epub"))
  generated = candidates.reject { |f| File.basename(f) == "#{basename}.epub" }.first || target
  if generated != target && File.exist?(generated)
    puts "Renaming #{generated} -> #{target}"
    FileUtils.mv(generated, target)
  elsif File.exist?(target)
    puts "Output: #{target}"
  end
end

begin
  if ext == ".cbz"
    puts "Adding ComicInfo.xml to #{file} with 7z"
    system("7z", "a", "-tzip", file, xml_file)
    convert(file, file, title, dir, kcc_opts)
  else # .cbr
    puts "Extracting #{file} and adding ComicInfo.xml..."
    Dir.mktmpdir do |tmpdir|
      extract_dir = File.join(tmpdir, "extract")
      FileUtils.mkdir_p(extract_dir)
      extracted = if UNAR
                    system(UNAR, "-quiet", "-force-overwrite", "-no-directory", "-output-directory", extract_dir, file)
                  else
                    system("7z", "x", file, "-o#{extract_dir}")
                  end
      abort "Error: Failed to extract #{file}" unless extracted
      FileUtils.cp(xml_file, extract_dir)
      temp_cbz = File.join(tmpdir, "#{basename}.cbz")
      files_to_add = Dir.entries(extract_dir) - %w[. ..]
      Dir.chdir(extract_dir) do
        system("7z", "a", "-tzip", temp_cbz, *files_to_add)
      end
      convert(temp_cbz, file, title, dir, kcc_opts)
    end
  end
ensure
  File.delete(xml_file) if File.exist?(xml_file)
end
