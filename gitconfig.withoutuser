
[alias]
  ci = commit
  co = checkout
  st = status -sb
  ts = st
  sh = stash
  cia = commit -am
  ; lg = log --pretty=format:\"%C(red)%h%C(reset) %C(yellow)%cr%C(reset) | %\"\"s%d [%C(bold blue)%an%C(reset)]\" --graph --date=short
  lg = !git-lg
  mt = mergetool
  df = !delta --color-only

[merge]
  conflictstyle = diff3

[color]
  ui = true

[core]
  excludesfile = ~/.gitignore
  editor = nvim

[push]
  default = upstream

[advice]
  pushNonFastForward = false
  statusHints = false
  commitBeforeMerge = false
  resolveConflict = false
  implicitIdentity = false
  detachedHead = false

[init]
	defaultBranch = main

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection

[merge]
    tool = vimdiff

[mergetool "vimdiff"]
    path = nvim
    cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
